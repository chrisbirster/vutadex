{
  "name": "vutadex",
  "version": "0.5.0",
  "description": "Local-first TypeScript flashcards CLI",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "node --experimental-strip-types scripts/style.ts --check",
    "format": "node --experimental-strip-types scripts/style.ts --write",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include-all --test-coverage-include=commands/*.ts --test-coverage-include=database/*.ts --test-coverage-include=fsrs/*.ts --test-coverage-include=services/*.ts --test-coverage-include=utils/*.ts --test-coverage-include=index.ts test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "5.9.3"
  }
}
