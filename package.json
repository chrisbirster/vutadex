{
  "name": "vutadex",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "dev:api": "go run ./cmd/vutadex",
    "typecheck": "tsc --noEmit",
    "test:go": "go test ./...",
    "build:web": "vite build",
    "build:server": "CGO_ENABLED=0 go build -trimpath ./cmd/vutadex",
    "build": "pnpm build:web && pnpm build:server",
    "verify": "pnpm typecheck && pnpm build:web && pnpm test:go && pnpm build:server",
    "db:plan": "atlas schema apply --env local --dry-run",
    "db:apply": "atlas schema apply --env local --auto-approve",
    "db:prod:plan": "atlas schema apply --env production --dry-run",
    "infra:dev": "sst dev",
    "infra:deploy": "sst deploy --stage production"
  },
  "dependencies": {
    "@solidjs/router": "next",
    "@solidjs/web": "next",
    "@stylexjs/stylex": "0.19.0",
    "solid-js": "next"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "next",
    "@stylexjs/unplugin": "0.19.0",
    "sst": "^3.17.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  }
}
