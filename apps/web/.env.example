# Local examples. Node does not automatically read this file.
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3001
VUTADEX_DB=./data/vutadex-web.db

# Proposed Fly settings live in fly.toml [env], not secrets:
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3001
# VUTADEX_DB=/data/vutadex-web.db
#
# Set APP_ORIGIN via Fly secrets to the EXACT browser-facing HTTPS origin
# (scheme + host + nonstandard port, if any; no path or trailing slash).
# Origin-mismatched API mutations are intentionally rejected.
#
# Production SES v2 HTTPS adapter: set these only as Fly secrets.
# AWS_REGION is the region containing the SES-verified sender.
# SES_FROM_EMAIL must be an SES-verified email identity.
# The IAM access key needs ses:SendEmail permission in that region.
AWS_REGION=
SES_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary IAM credentials:
AWS_SESSION_TOKEN=
