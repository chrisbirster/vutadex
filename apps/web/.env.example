APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
VUTADEX_DB=./data/vutadex-web.db
# Production adapter: AWS SES v2 HTTPS with AWS SigV4 and server-only credentials.
# Configure SES verified sender/domain and IAM permission ses:SendEmail before production use.
AWS_REGION=
SES_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional IAM temporary credentials
AWS_SESSION_TOKEN=
