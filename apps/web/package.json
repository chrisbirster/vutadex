{
  "name": "@vutadex/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch --experimental-strip-types server/index.ts\"",
    "server": "node --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "inspect:legacy": "node --experimental-strip-types scripts/legacy-inspect.ts",
    "export:legacy-history": "node --experimental-strip-types scripts/export-history.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.131.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pino": "^9.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "typescript": "5.9.3",
    "vite": "^7.3.0"
  }
}
